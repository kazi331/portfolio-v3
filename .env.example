# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GitHub fine-grained token with public repository read access.
# Used server-side to query pinned repositories through GitHub GraphQL.
GITHUB_TOKEN="MY_GITHUB_TOKEN"

# EmailJS credentials for contact form submissions (https://www.emailjs.com/)
# SERVICE_ID: The Service ID from EmailJS dashboard (e.g. "service_xxxxxxx")
EMAILJS_SERVICE_ID=""
# TEMPLATE_ID: The Template ID configured in EmailJS (e.g. "template_xxxxxxx")
EMAILJS_TEMPLATE_ID=""
# PUBLIC_KEY: Your EmailJS Public Key / User ID (found in Account > API Keys)
EMAILJS_PUBLIC_KEY=""
# PRIVATE_KEY: Optional EmailJS Private Key (if Access Token verification is enabled)
EMAILJS_PRIVATE_KEY=""

# Local admin account created by `bun run db:seed`.
# The password is hashed with Better Auth before it is stored.
SEED_ADMIN_NAME="Kazi Shariful Islam"
SEED_ADMIN_EMAIL="kazisharif.dev@gmail.com"
SEED_ADMIN_PASSWORD=""
